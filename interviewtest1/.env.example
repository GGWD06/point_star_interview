# =====================================================
# Agentic Email Processing System — Environment Config
# =====================================================
# Copy this file to .env and fill in your values.

# --- LLM Provider ---
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL_CLASSIFIER=gemini-1.5-pro
GOOGLE_MODEL_DRAFTER=gemini-1.5-pro
GOOGLE_MODEL_JUDGE=gemini-1.5-flash
GOOGLE_EMBEDDING_MODEL=text-embedding-004

# --- Vector Store ---
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=email_support_kb

# --- RAG Retrieval ---
RAG_TOP_K=5
RAG_RELEVANCE_THRESHOLD=0.7

# --- Redis (contact frequency tracking) ---
# Leave empty to use in-memory fallback for local development
REDIS_URL=redis://localhost:6379/0

# --- Escalation Rules ---
ESCALATION_CONTACT_WINDOW_DAYS=7
ESCALATION_CONTACT_THRESHOLD=3

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=change-me-in-production
